{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "orderStatus": {
      "type": "enumeration",
      "required": true,
      "default": "pending",
      "enum": [
        "pending",
        "paid",
        "failed",
        "expired"
      ]
    },
    "midtransOrderId": {
      "type": "string",
      "required": false,
      "unique": true
    },
    "midtransSnapToken": {
      "type": "string",
      "required": false
    },
    "biteshipOrderId": {
      "type": "string",
      "required": false
    },
    "waybillId": {
      "type": "string",
      "required": false
    },
    "address": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::address.address",
      "inversedBy": "orders"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "orders"
    },
    "items": {
      "type": "json",
      "required": true
    },
    "shipping": {
      "type": "json",
      "required": true
    }
  }
}

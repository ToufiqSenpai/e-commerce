{
  "name": "e-commerce-root",
  "version": "1.0.0",
  "private": true,
  "description": "Root workspace for the e-commerce monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w web\"",
    "dev:backend": "npm run dev -w backend",
    "dev:web": "npm run dev -w web",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build -w backend",
    "build:web": "npm run build -w web",
    "test:web": "npm run test -w web",
    "lint": "npm run lint --workspaces --if-present",
    "lint:backend": "npm run lint -w backend",
    "lint:web": "npm run lint -w web",
    "format": "prettier --write \"**/*.{ts,js,mjs,vue,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,vue,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0",
    "unstorage": "^1.17.5"
  }
}
